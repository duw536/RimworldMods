<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ========================================================= -->
  <!-- Knife Pistol -->
  <!-- ========================================================= -->

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>KnifePistol</defName>
    <label>knifepistol</label>
    <description>H: 근접공격 B: 원거리사격</description>

    <!-- ======================================================= -->
    <!-- 기본 그래픽 -->
    <!-- ======================================================= -->
    <graphicData>
      <!-- 바닥에 떨어져 있거나 기본 상태일 때 사용할 텍스처 경로 -->
      <texPath>Things/Item/Equipment/KnifePistol</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>

    <!-- ======================================================= -->
    <!-- 동적 텍스처 Component (C# 연결) -->
    <!-- ======================================================= -->
    <comps>
      <li Class="KnifePistolMod.CompProperties_DynamicTexture">
        <!-- 근접 상태 (칼) 텍스처 경로 -->
        <meleeTexPath>Things/Item/Equipment/KnifePistol_Melee</meleeTexPath>
        <!-- 원거리 상태 (총) 텍스처 경로 -->
        <rangedTexPath>Things/Item/Equipment/KnifePistol</rangedTexPath>
      </li>
    </comps>

    <uiIconScale>1.5</uiIconScale>
    <soundInteract>Interact_Autopistol</soundInteract>

    <!-- ======================================================= -->
    <!-- 제작 조건 -->
    <!-- ======================================================= -->
    <recipeMaker>
      <researchPrerequisite>BlowbackOperation</researchPrerequisite>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <displayPriority>405</displayPriority>
    </recipeMaker>

    <!-- ======================================================= -->
    <!-- 무기 태그 & 클래스 -->
    <!-- ======================================================= -->
    <weaponTags>
      <li>SimpleGun</li>
      <li>Autopistol</li>
    </weaponTags>

    <weaponClasses>
      <li>RangedLight</li>
      <li>Melee</li>
    </weaponClasses>

    <!-- ======================================================= -->
    <!-- 스탯 -->
    <!-- ======================================================= -->
    <statBases>
      <WorkToMake>5000</WorkToMake>
      <Mass>1.2</Mass>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.70</AccuracyShort>
      <AccuracyMedium>0.40</AccuracyMedium>
      <AccuracyLong>0.30</AccuracyLong>
      <RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
    </statBases>

    <!-- ======================================================= -->
    <!-- 제작 재료 -->
    <!-- ======================================================= -->
    <costList>
      <Steel>30</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>

    <!-- ======================================================= -->
    <!-- 원거리 사격 -->
    <!-- ======================================================= -->
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_KnifePistol</defaultProjectile>
        <warmupTime>0.3</warmupTime>
        <range>25.9</range>
        <soundCast>Shot_Autopistol</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>

    <!-- ======================================================= -->
    <!-- 근접 공격 -->
    <!-- ======================================================= -->
    <tools>
      <!-- 손잡이 -->
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>

      <!-- 칼날 -->
      <li>
        <label>blade</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>12</power>
        <cooldownTime>1.5</cooldownTime>
      </li>

      <!-- 칼끝 -->
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>13</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>

  </ThingDef>


  <!-- ========================================================= -->
  <!-- Knife Pistol Bullet -->
  <!-- ========================================================= -->

  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_KnifePistol</defName>
    <label>knifepistolbullet</label>

    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>

    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>10</damageAmountBase>
      <speed>55</speed>
    </projectile>
  </ThingDef>

</Defs>